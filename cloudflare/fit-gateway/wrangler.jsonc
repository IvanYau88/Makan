{
  "name": "makan-fit-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "GATEWAY_SCOPE": "preview", "GATEWAY_ENABLED": "0" },
  "durable_objects": {
    "bindings": [{ "name": "COORDINATOR", "class_name": "FitCoordinator" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FitCoordinator"] }],
}
