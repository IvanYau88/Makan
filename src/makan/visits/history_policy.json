{
  "version": "owner-history-v1",
  "status": "hypothesis_awaiting_qualification",
  "owner_only": "Only the owner's own rows: their restaurant ratings (origin fresh or confirmed) and their own dish rows. A visit made from an accepted tag counts as rated only once its owner rated it. The tagger's visit, dishes, tags and notes are never read, and no other person's rows are queried.",
  "excluded": [
    "companions",
    "notes",
    "descriptions",
    "dish comments",
    "dates",
    "addresses",
    "place names",
    "place ids",
    "user ids",
    "free text"
  ],
  "read_limit_visits": 1000,
  "too_long": "An owner with more than read_limit_visits visits gets no history evidence and an Unrated assessment: unread older visits could hold a dislike, so the history is never truncated.",
  "averages": "Unweighted means of every eligible restaurant rating and every eligible dish rating, each read against its own kind.",
  "fading": {
    "half_life_days": 365,
    "rule": "weight = 0.5 ** (age_days / half_life_days), age from the visit day to today in UTC, never below zero days. Weights never reach zero, so an old or weakened taste still counts a little."
  },
  "dish_context": {
    "margin": 0.5,
    "stands_apart": 1.5,
    "follows_restaurant": 0.5,
    "neutral": 1.0,
    "rule": "A dish's weight is multiplied by stands_apart when the dish and its restaurant both differ from their own averages by at least margin in opposite directions (a low dish at a liked restaurant counts more against that dish), by follows_restaurant when they differ in the same direction, and by neutral otherwise, including when the owner has not rated the restaurant."
  },
  "lean": {
    "well_above": 1.5,
    "above": 0.5,
    "below": -0.5,
    "well_below": -1.5,
    "rule": "The weighted mean of (rating - own average): at least well_above is well_above, at least above is above, at most well_below is well_below, at most below is below, and anything between is near."
  },
  "mixed": {
    "margin": 1.0,
    "dominance": 2.0,
    "rule": "When evidence at least margin above and at least margin below the average both exist and neither side's weight is dominance times the other's, the lean is mixed instead of an average that hides the conflict."
  },
  "strength": {
    "some": 1.0,
    "strong": 3.0,
    "rule": "Total weight below some is faint, below strong is some, otherwise strong."
  },
  "count_buckets": {
    "one": 1,
    "few": 2,
    "many": 5,
    "rule": "0 is none, 1 is one, 2 to 4 is few, 5 or more is many."
  },
  "normalization": "Dish names and tags are matched after NFKD with combining marks removed, case folding, and every run of characters that are not letters or digits replaced by one space. Only the canonical id of a match ever leaves the server; the typed text never does.",
  "dish_matching": "A dish matches the aliases contained in its name as whole words, ignoring an alias that lies inside a longer matched alias. Matches of two different dishes match nothing, so a combined name is never guessed. A dish's cuisine comes from its dish id or from an exact cuisine tag, and a conflict between them gives no cuisine.",
  "tag_matching": "A tag matches when its whole normalized text equals an alias. 'not ' followed by an alias of X is the separate id not_X, so negation is literal. Occasion tags such as lunch, and every unknown tag, are no taste evidence.",
  "visit_cuisine": "A visit's restaurant rating counts for a cuisine only when every recognized dish on that visit has that one cuisine.",
  "max_tags": 24,
  "selection": "Every cuisine summary, only the dish summaries of the candidate's cuisine, and the owner's own visits at the candidate itself. A dish of another cuisine is still counted in its cuisine summary. At most max_tags tag summaries are kept: first those leaning below, well_below or mixed, then the rest, each by total weight and then id. When a summary leaning below, well_below or mixed would be left out, that is a material omission and the whole history is unusable (Unrated), so a dislike is never dropped silently.",
