# Copy to .env and fill in the values you need. Never commit .env.

# LLM providers
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model names live in config, not code. Set the default here.
MAKAN_MODEL=

# Fixed-answer scorer for the soft decision points, such as soft request signals. Off by
# default. The backend is one of: none, logprob, structured, jev, fake. Blank means none.
#   logprob     needs a chat model whose endpoint returns token logprobs. Gives probabilities.
#   structured  needs a model with JSON schema output. Gives a choice and a rough self rating only.
#   jev         is hosted Jev (typesafe/jev-1.13) on OpenRouter's Decisions API. It is paid, so it
#               runs only when named here, and nothing ever falls back to it.
#   fake        is a deterministic offline stand-in with no model and no key.
# A hosted backend needs MAKAN_SCORER_MODEL and OPENROUTER_API_KEY. Check OpenRouter's model list
# for logprob support before choosing a model, and set a credit limit on the key.
MAKAN_SCORER_BACKEND=
MAKAN_SCORER_MODEL=
# Seconds to wait for one scoring request. Default is 15.
MAKAN_SCORER_TIMEOUT_SECONDS=

# Per-run loop limits. Defaults are 10 model calls and 50000 tokens.
MAKAN_MAX_ITERATIONS=
MAKAN_TOKEN_BUDGET=

# Graph workflow limits. Defaults are 4 steps at once and 30 seconds for a step.
MAKAN_GRAPH_MAX_CONCURRENCY=
MAKAN_GRAPH_STEP_TIMEOUT_SECONDS=

# Places data. Overture Maps is free and needs no key.
# Leave the release blank for the latest, or pin one such as 2026-09-23.1.
MAKAN_OVERTURE_RELEASE=
# How long a places lookup is remembered in memory. Default is 86400 (one day).
MAKAN_PLACES_CACHE_TTL_SECONDS=

# Web channel. Set MAKAN_DEMO=1 to run with sample places and no API key or network.
# Otherwise the web app needs MAKAN_MODEL and OPENROUTER_API_KEY above.
MAKAN_DEMO=
# Where the built front end lives. Blank means web/dist in this repository.
MAKAN_WEB_DIST=
# Front end development only: where the Vite dev server proxies /api. Default is http://127.0.0.1:8000.
# `python -m makan.web` listens there by default, so this matters only when you use another host or port.
MAKAN_API_URL=
# The app loads .env from the current directory. Set this in the real environment, not here,
# to load another file instead. Variables already set in the environment are never overridden.
# MAKAN_ENV_FILE=
# Web map tiles. Leave all three blank for OpenStreetMap's own tiles, which are a best effort
# service for light use. To use another provider, set a raster tile template with {z}, {x} and {y},
# and the credit it requires, which is always shown beside the map.
MAKAN_MAP_TILE_URL=
MAKAN_MAP_ATTRIBUTION=
# Where the attribution links to. Optional.
MAKAN_MAP_ATTRIBUTION_URL=

# Group sessions. How many hours a shared group session lives after it is created, then it expires
# and is gone for everyone. Default is 24.
MAKAN_SESSION_RETENTION_HOURS=
# How often, in minutes, the server deletes expired group sessions and what they hold, once at
# startup and then on this interval. Default is 15.
MAKAN_SESSION_PURGE_INTERVAL_MINUTES=
# Postgres connection URL for saved group sessions, for example postgresql://host/db. For a hosted
# Supabase project use its session pooler connection string (see README, Hosted database).
# Apply the files in migrations/ to it first. Blank keeps group sessions in memory, so they are
# lost when the server restarts, and demo mode always does. Needs the postgres extra.
MAKAN_DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Postgres for the schema tests, for example postgresql://postgres@localhost:5432/postgres.
# The tests create and drop their own schema. They are skipped when this is blank.
MAKAN_TEST_DATABASE_URL=

# Telegram (personal use channel)
TELEGRAM_BOT_TOKEN=

# Optional paid upgrade for places data
GOOGLE_PLACES_API_KEY=
